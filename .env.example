# Polymarket credentials — required only for trading (display works without)
# Private key from reveal.polymarket.com or MetaMask (with or without 0x prefix)
POLYMARKET_PRIVATE_KEY=
# Address that holds the funds. Same as your wallet for an EOA wallet;
# your Polymarket proxy address for email/Magic or browser-proxy wallets.
POLYMARKET_FUNDER=
# 0 = EOA (default), 1 = Email/Magic, 2 = Browser proxy
POLYMARKET_SIGNATURE_TYPE=0
